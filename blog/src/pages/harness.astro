---
import HarnessLayout from '../layouts/HarnessLayout.astro';
import { sections, references } from '../data/harness';
---

<HarnessLayout title="Harness — Coding Agent Workflow" description="A systematic guide to harnessing your coding agent for maximum productivity">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-8 pt-20 pb-10">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-white">
          Harness
        </h1>
        <p class="mt-4 text-lg text-gray-500 dark:text-gray-400 max-w-2xl">
          A systematic workflow for getting the most out of Coding Agent — from setup to compounding knowledge.
        </p>
      </div>
      <a
        href="/harness/all"
        class="flex-shrink-0 group flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-400 dark:hover:border-gray-500 transition-all"
        title="Read all sections as feed"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z" />
        </svg>
        <span class="hidden sm:inline">View as Feed</span>
      </a>
    </div>
  </section>

  <!-- Card Grid -->
  <section class="max-w-6xl mx-auto px-8 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sections.map((section, i) => (
        <a
          href={`/harness/${section.slug}`}
          class={`harness-card group relative overflow-hidden rounded-2xl bg-gradient-to-br ${section.gradient} text-white min-h-[200px] sm:min-h-[240px] lg:min-h-[40vh] flex flex-col justify-between p-7 transition-all duration-500 hover:scale-[1.02] hover:shadow-2xl hover:brightness-110`}
          style={`animation-delay: ${i * 80}ms`}
        >
          {/* Top: category number */}
          <div class="relative z-10">
            <span class="font-mono text-xs tracking-widest uppercase opacity-60">
              {String(section.number).padStart(2, '0')}
            </span>
          </div>

          {/* Background icon — centered, large, ghostly */}
          <svg
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-36 h-36 opacity-10 group-hover:opacity-20 group-hover:scale-110 transition-all duration-700"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d={section.iconPath} />
          </svg>

          {/* Bottom: title + summary */}
          <div class="relative z-10">
            <h2 class="text-2xl sm:text-3xl font-bold leading-tight">{section.title}</h2>
            <p class="text-xs sm:text-sm opacity-60 mt-1.5 line-clamp-2">{section.summary}</p>
          </div>

          {/* Hover arrow */}
          <svg
            class="absolute bottom-7 right-7 w-5 h-5 opacity-0 group-hover:opacity-70 translate-x-2 group-hover:translate-x-0 transition-all duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- References -->
  <section id="references" class="max-w-6xl mx-auto px-8 pb-20">
    <hr class="mb-12 border-gray-200 dark:border-gray-800" />
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">References</h2>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Articles and talks that shaped this workflow.</p>
    <ol class="mt-8 space-y-4">
      {references.map((ref, i) => (
        <li>
          <a href={ref.url} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-xs font-semibold text-gray-500 dark:text-gray-400">
              {i + 1}
            </span>
            <div class="pt-0.5">
              <span class="text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{ref.title}</span>
              <span class="block text-xs text-gray-400 dark:text-gray-500 mt-0.5">{ref.domain}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('harness-card-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.harness-card').forEach((card) => {
      observer.observe(card);
    });
  </script>
</HarnessLayout>
