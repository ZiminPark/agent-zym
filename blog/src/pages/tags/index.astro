---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---

<BaseLayout
  title="Tags | agent-zym"
  description="Browse all tags on agent-zym blog"
>
  <div class="space-y-12">
    <header class="stagger-in">
      <p class="mono-label mb-4">Browse by topic</p>
      <h1 class="display-heading text-5xl md:text-6xl" style="color: var(--text);">
        All Tags
      </h1>
    </header>

    <div class="flex flex-wrap gap-3 stagger-in" style="animation-delay: 100ms;">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}`} class="tag-pill group" style="padding: 0.5rem 1rem; font-size: 0.75rem;">
          <span>{tag}</span>
          <span class="ml-2 opacity-50">{count}</span>
        </a>
      ))}
    </div>

    {sortedTags.length === 0 && (
      <p style="color: var(--text-muted);">No tags yet.</p>
    )}
  </div>
</BaseLayout>
