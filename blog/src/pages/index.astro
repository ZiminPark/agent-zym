---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Search from '../components/Search.astro';

const allPosts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

const posts = allPosts.sort((a, b) => {
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<BaseLayout
  title="agent-zym"
  description="A warm, practical journal for AI and agent development stories"
>
  <div class="space-y-14 sm:space-y-16">
    <section class="hero-shell paper-surface stagger-in px-5 sm:px-8 py-8 sm:py-10">
      <p class="mono-label hero-kicker">zimmy.dev journal</p>
      <h1 class="display-heading hero-title mt-3">
        Warm notes for
        <span class="hero-highlight">agentic builders</span>
      </h1>
      <p class="hero-copy mt-4 max-w-2xl">
        A calm feed of workflows, plugin experiments, and practical lessons from building with AI and agents.
      </p>
    </section>

    <section class="stagger-in" style="animation-delay: 70ms;">
      <Search />
    </section>

    <section class="stagger-in" style="animation-delay: 140ms;">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-4 sm:mb-5">
        <h2 class="display-heading text-4xl sm:text-5xl" style="color: var(--text);">Latest Posts</h2>
        <span class="mono-label">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      </div>
      <div class="ink-divider mb-5"></div>
      <div>
        {posts.map((post, i) => <PostCard post={post} index={i} />)}
      </div>
    </section>

    {posts.length === 0 && (
      <p class="text-center" style="color: var(--text-muted);">No posts yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .hero-shell {
    position: relative;
    overflow: hidden;
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    right: -2.1rem;
    top: -2.3rem;
    width: 8.6rem;
    height: 8.6rem;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 42%, var(--border));
    opacity: 0.48;
    pointer-events: none;
  }

  .hero-kicker {
    color: var(--text-subtle);
  }

  .hero-title {
    color: var(--text);
    font-size: clamp(2.3rem, 7vw, 4.9rem);
    line-height: 0.96;
    max-width: 17ch;
  }

  .hero-highlight {
    display: block;
    color: color-mix(in srgb, var(--color-accent) 85%, var(--text));
  }

  .hero-copy {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.72;
  }

  @media (max-width: 640px) {
    .hero-copy {
      font-size: 0.98rem;
      line-height: 1.66;
    }

    .hero-shell::after {
      width: 6.5rem;
      height: 6.5rem;
      right: -1.55rem;
      top: -1.85rem;
    }
  }
</style>
