---
import HarnessLayout from '../../layouts/HarnessLayout.astro';
import { sections } from '../../data/harness';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return sections.map((s) => ({ params: { section: s.slug } }));
};

const { section: slug } = Astro.params;
const sectionIndex = sections.findIndex((s) => s.slug === slug);
const section = sections[sectionIndex]!;
const prev = sectionIndex > 0 ? sections[sectionIndex - 1] : null;
const next = sectionIndex < sections.length - 1 ? sections[sectionIndex + 1] : null;
---

<HarnessLayout title={`${section.title} — Harness`} description={section.summary}>
  <article class="max-w-4xl mx-auto px-6 py-12">
    {/* Breadcrumb */}
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8">
      <a href="/harness" class="hover:text-gray-900 dark:hover:text-white transition-colors">Harness</a>
      <span>/</span>
      <span class="text-gray-900 dark:text-white">{section.title}</span>
    </nav>

    {/* Header */}
    <header class="mb-12">
      <span class="font-mono text-sm text-gray-400 dark:text-gray-500">
        {String(section.number).padStart(2, '0')}
      </span>
      <h1 class={`text-4xl md:text-5xl font-bold mt-1 bg-gradient-to-r ${section.gradient} bg-clip-text text-transparent`}>
        {section.title}
      </h1>
      <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">{section.summary}</p>
    </header>

    {/* Content */}
    <ol class="space-y-6">
      {section.items.map((item, i) => (
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-sm font-semibold text-gray-600 dark:text-gray-300">
            {i + 1}
          </span>
          <div class="pt-1">
            <p class="text-gray-900 dark:text-gray-100 leading-relaxed">{item.text}</p>
            {item.subItems && (
              <ul class="mt-3 space-y-2 pl-4 border-l-2 border-gray-200 dark:border-gray-700">
                {item.subItems.map((sub) => (
                  <li class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{sub}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    {/* Prev/Next Navigation */}
    <nav class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 flex justify-between">
      {prev ? (
        <a href={`/harness/${prev.slug}`} class="group flex items-center gap-2 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          <span class="text-sm">{prev.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/harness/${next.slug}`} class="group flex items-center gap-2 text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
          <span class="text-sm">{next.title}</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ) : <div />}
    </nav>
  </article>
</HarnessLayout>
