---
import HarnessLayout from '../../layouts/HarnessLayout.astro';
import HarnessImage from '../../components/HarnessImage.astro';
import { sections } from '../../data/harness';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return sections.map((s) => ({ params: { section: s.slug } }));
};

const { section: slug } = Astro.params;
const sectionIndex = sections.findIndex((s) => s.slug === slug);
const section = sections[sectionIndex]!;
const prev = sectionIndex > 0 ? sections[sectionIndex - 1] : null;
const next = sectionIndex < sections.length - 1 ? sections[sectionIndex + 1] : null;

function highlight(text: string): string {
  return text.replace(/읽는다|읽고 이해한다/g, (m) => `<mark class="harness-highlight">${m}</mark>`);
}
---

<HarnessLayout title={`${section.title} — Harness`} description={section.summary}>
  <article class="max-w-4xl mx-auto px-6 py-12">
    {/* Breadcrumb */}
    <nav class="flex items-center gap-2 text-sm mb-8" style="color: var(--text-muted);">
      <a href="/harness" class="link-underline transition-colors" style="color: var(--text-muted);">Harness</a>
      <span>/</span>
      <span style="color: var(--text);">{section.title}</span>
    </nav>

    {/* Header */}
    <header class="mb-12">
      <span class="mono-label">
        {String(section.number).padStart(2, '0')}
      </span>
      <h1 class={`display-heading text-4xl md:text-5xl mt-1 bg-gradient-to-r ${section.gradient} bg-clip-text text-transparent`}>
        {section.title}
      </h1>
      <p class="mt-4 text-lg" style="color: var(--text-muted);">{section.summary}</p>
    </header>

    {/* Content */}
    <ol class="space-y-6">
      {section.items.map((item, i) => (
        <li class="flex gap-4">
          <span
            class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold"
            style="background: var(--bg-surface); color: var(--text-muted);"
          >
            {i + 1}
          </span>
          <div class="pt-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-2">
              <p class="leading-relaxed" style="color: var(--text);" set:html={highlight(item.text)} />
              {item.link && (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[11px] font-medium uppercase tracking-wider opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap"
                  style="color: var(--text-muted);"
                >
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                  </svg>
                  Reference
                </a>
              )}
            </div>
            {item.subItems && (
              <ul class="mt-3 space-y-2 pl-4" style="border-left: 2px solid var(--border);">
                {item.subItems.map((sub) => (
                  <li class="text-sm leading-relaxed" style="color: var(--text-muted);" set:html={highlight(sub)} />
                ))}
              </ul>
            )}
            {item.image && <HarnessImage image={item.image} />}
          </div>
        </li>
      ))}
    </ol>

    {/* Prev/Next Navigation */}
    <nav class="mt-16 pt-8 flex justify-between" style="border-top: 1px solid var(--border);">
      {prev ? (
        <a href={`/harness/${prev.slug}`} class="group flex items-center gap-2 transition-colors" style="color: var(--text-muted);">
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          <span class="text-sm">{prev.title}</span>
        </a>
      ) : <div />}
      {next ? (
        <a href={`/harness/${next.slug}`} class="group flex items-center gap-2 transition-colors" style="color: var(--text-muted);">
          <span class="text-sm">{next.title}</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ) : <div />}
    </nav>
  </article>
</HarnessLayout>
