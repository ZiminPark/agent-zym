---
import HarnessLayout from '../../layouts/HarnessLayout.astro';
import { sections, references } from '../../data/harness';
---

<HarnessLayout title="Harness — Full Guide" description="The complete coding agent workflow guide in one page">
  <article class="max-w-3xl mx-auto px-6 sm:px-8 py-12">
    {/* Page title */}
    <header class="mb-16">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white">
            Harness
          </h1>
          <p class="mt-3 text-base text-gray-500 dark:text-gray-400">
            The complete guide — all six sections.
          </p>
        </div>
        <a
          href="/harness"
          class="flex-shrink-0 flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-700 px-4 py-2 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:border-gray-400 dark:hover:border-gray-500 transition-all"
          title="View as Grid"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" />
          </svg>
          <span class="hidden sm:inline">View as Grid</span>
        </a>
      </div>
    </header>

    {/* Sections */}
    {sections.map((section, sectionIndex) => (
      <section id={section.slug} class="scroll-mt-24">
        {/* Gradient banner */}
        <div class={`rounded-xl bg-gradient-to-r ${section.gradient} p-5 sm:p-6 text-white flex items-center justify-between`}>
          <div>
            <span class="font-mono text-xs tracking-widest opacity-60">
              {String(section.number).padStart(2, '0')}
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold mt-0.5">{section.title}</h2>
            <p class="text-sm opacity-70 mt-1">{section.summary}</p>
          </div>
          <svg
            class="w-16 h-16 opacity-20 flex-shrink-0 ml-4 hidden sm:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d={section.iconPath} />
          </svg>
        </div>

        {/* Items */}
        <ol class="mt-8 space-y-5">
          {section.items.map((item, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-xs font-semibold text-gray-500 dark:text-gray-400">
                {i + 1}
              </span>
              <div class="pt-0.5">
                <p class="text-gray-900 dark:text-gray-100 leading-relaxed">{item.text}</p>
                {item.subItems && (
                  <ul class="mt-2.5 space-y-1.5 pl-4 border-l-2 border-gray-200 dark:border-gray-700">
                    {item.subItems.map((sub) => (
                      <li class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">{sub}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>

        {/* Divider (except after last section) */}
        {sectionIndex < sections.length - 1 && (
          <hr class="my-14 border-gray-200 dark:border-gray-800" />
        )}
      </section>
    ))}

    {/* References */}
    <section id="references" class="scroll-mt-24">
      <hr class="my-14 border-gray-200 dark:border-gray-800" />
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">References</h2>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Articles and talks that shaped this workflow.</p>
      <ol class="mt-8 space-y-4">
        {references.map((ref, i) => (
          <li>
            <a href={ref.url} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-xs font-semibold text-gray-500 dark:text-gray-400">
                {i + 1}
              </span>
              <div class="pt-0.5">
                <span class="text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{ref.title}</span>
                <span class="block text-xs text-gray-400 dark:text-gray-500 mt-0.5">{ref.domain}</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {/* Bottom nav */}
    <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
      <a href="/harness" class="inline-flex items-center gap-1.5 text-sm text-gray-400 dark:text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to Harness
      </a>
    </div>
  </article>
</HarnessLayout>
