---
import HarnessLayout from '../../layouts/HarnessLayout.astro';
import ContextActions from '../../components/ContextActions.astro';
import HarnessViewToggle from '../../components/HarnessViewToggle.astro';
import { sections, references } from '../../data/harness';
---

<HarnessLayout
  title="Harness — Coding Agent Workflow (Grid)"
  description="A card-grid overview of the coding agent workflow"
  llmContextHref="/harness/grid.md"
>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-20 pb-8 sm:pb-10">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="display-heading text-4xl sm:text-5xl md:text-6xl" style="color: var(--text);">
          Harness
        </h1>
        <p class="mt-3 sm:mt-4 text-base sm:text-lg max-w-2xl" style="color: var(--text-muted);">
          A systematic workflow for getting the most out of Coding Agent — from setup to compounding knowledge.
        </p>
      </div>
      <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto sm:justify-end lg:flex-shrink-0">
        <HarnessViewToggle active="grid" />
        <ContextActions
          markdownPath="/harness/grid.md"
          canonicalPath="/harness/grid"
          title="Harness — Coding Agent Workflow (Grid)"
          tags={['harness', 'coding-agent', 'workflow', 'grid']}
          hint="Use this workflow overview as source context. Keep steps concrete and actionable."
          align="end"
        />
      </div>
    </div>
  </section>

  <!-- Card Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sections.map((section, i) => (
        <a
          href={`/harness/${section.slug}`}
          class={`harness-card group relative overflow-hidden rounded-2xl bg-gradient-to-br ${section.gradient} text-white min-h-[140px] sm:min-h-[160px] lg:min-h-[28vh] flex flex-col justify-between p-7 transition-all duration-500 hover:scale-[1.02] hover:shadow-2xl hover:brightness-110`}
          style={`animation-delay: ${i * 80}ms`}
        >
          {/* Top: category number */}
          <div class="relative z-10">
            <span class="font-mono text-xs tracking-widest uppercase opacity-60">
              {String(section.number).padStart(2, '0')}
            </span>
          </div>

          {/* Background icon — centered, large, ghostly */}
          <svg
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 opacity-10 group-hover:opacity-20 group-hover:scale-110 transition-all duration-700"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d={section.iconPath} />
          </svg>

          {/* Bottom: title + summary */}
          <div class="relative z-10">
            <h2 class="text-2xl sm:text-3xl font-bold leading-tight">{section.title}</h2>
            <p class="text-xs sm:text-sm opacity-60 mt-1.5 line-clamp-2">{section.summary}</p>
          </div>

          {/* Hover arrow */}
          <svg
            class="absolute bottom-7 right-7 w-5 h-5 opacity-0 group-hover:opacity-70 translate-x-2 group-hover:translate-x-0 transition-all duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- References -->
  <section id="references" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <hr style="border-color: var(--border);" class="mb-12" />
    <h2 class="display-heading text-2xl" style="color: var(--text);">References</h2>
    <p class="mt-2 text-sm" style="color: var(--text-muted);">Articles and talks that shaped this workflow.</p>
    <ol class="mt-8 space-y-4">
      {references.map((ref, i) => (
        <li>
          <a href={ref.url} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4">
            <span
              class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold"
              style="background: var(--bg-surface); color: var(--text-muted);"
            >
              {i + 1}
            </span>
            <div class="pt-0.5">
              <span class="transition-colors" style="color: var(--text);">{ref.title}</span>
              <span class="block text-xs mt-0.5" style="color: var(--text-subtle);">{ref.domain}</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('harness-card-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.harness-card').forEach((card) => {
      observer.observe(card);
    });
  </script>
</HarnessLayout>
