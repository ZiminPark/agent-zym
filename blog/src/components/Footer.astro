---
---

<footer class="mt-24 pb-6">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="ink-divider"></div>
  </div>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-9 sm:py-11">
    <div class="footer-shell flex flex-col gap-7 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="footer-mark" aria-hidden="true">
            <svg viewBox="0 0 96 96" fill="none">
              <path
                d="M15 19C33 15 56 15 78 19C63 33 37 52 22 77C42 83 62 83 80 77"
                stroke="currentColor"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="display-heading text-2xl leading-none" style="color: var(--text);">agent-zym</span>
        </div>
        <p class="mt-3 max-w-md" style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.55;">
          Stories about agent workflows, tooling systems, and pragmatic experiments.
        </p>
        <p class="mt-3 mono-label" style="font-size: 0.65rem; color: var(--text-subtle);">
          &copy; {new Date().getFullYear()} agent-zym
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-5 sm:gap-7">
        <a
          href="https://github.com/ZiminPark/agent-zym"
          target="_blank"
          rel="noopener noreferrer"
          class="mono-label link-underline"
          style="font-size: 0.68rem;"
        >
          GitHub
        </a>
        <a href="/tags" class="mono-label link-underline" style="font-size: 0.68rem;">
          Tags
        </a>
        <a href="/rss.xml" class="mono-label link-underline" style="font-size: 0.68rem;">
          RSS Feed
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-shell {
    border: 1px solid color-mix(in srgb, var(--border) 74%, transparent);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--bg-elevated) 90%, transparent);
    box-shadow: var(--shadow-soft);
    padding: 1.3rem 1.25rem;
  }

  .footer-mark {
    width: 1.65rem;
    height: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.58rem;
    color: color-mix(in srgb, var(--color-accent) 86%, var(--text));
    background: color-mix(in srgb, var(--bg-surface) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .footer-mark svg {
    width: 1.18rem;
    height: 1.18rem;
  }

  @media (max-width: 640px) {
    .footer-shell {
      padding: 1.05rem 0.95rem;
    }
  }
</style>
