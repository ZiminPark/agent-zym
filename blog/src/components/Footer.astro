---
---

<footer class="mt-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div style="height: 1px; background: var(--border);"></div>
  </div>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-8 sm:py-10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div>
        <span class="display-heading text-lg" style="color: var(--text);">agent-zym</span>
        <p class="mt-1" style="font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.05em; color: var(--text-subtle);">
          &copy; {new Date().getFullYear()}
        </p>
      </div>
      <div class="flex flex-wrap gap-6 sm:gap-8">
        <a
          href="https://github.com/ZiminPark/agent-zym"
          target="_blank"
          rel="noopener noreferrer"
          class="mono-label link-underline"
          style="font-size: 0.6875rem;"
        >
          GitHub
        </a>
        <a href="/rss.xml" class="mono-label link-underline" style="font-size: 0.6875rem;">
          RSS Feed
        </a>
      </div>
    </div>
  </div>
</footer>
