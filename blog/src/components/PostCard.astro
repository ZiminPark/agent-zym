---
import { type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-card stagger-in" style={`animation-delay: ${index * 85}ms;`}>
  <a href={`/${post.slug}`} class="block">
    <div class="flex items-start justify-between gap-6 sm:gap-8">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3.5 mb-3">
          <span class="card-date">{formattedDate}</span>
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 sm:gap-2">
              {tags.slice(0, 3).map((tag) => (
                <span class="tag-pill" style="padding: 0.11rem 0.48rem; font-size: 0.6rem;">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <h2 class="card-title">{title}</h2>
        <p class="card-desc line-clamp-2">{description}</p>
      </div>
      {image && (
        <div class="hidden md:block card-thumb-wrap flex-shrink-0 w-32 h-24 rounded-xl overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .card-thumb-wrap {
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    box-shadow: 0 8px 20px rgba(77, 58, 37, 0.1);
    background: var(--bg-surface);
  }
</style>
