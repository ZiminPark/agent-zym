---
import { type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-card stagger-in" style={`animation-delay: ${index * 80}ms;`}>
  <a href={`/${post.slug}`} class="block">
    <div class="flex items-start justify-between gap-8">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-3">
          <span class="card-date">{formattedDate}</span>
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.slice(0, 3).map((tag) => (
                <span class="tag-pill" style="padding: 0.125rem 0.5rem; font-size: 0.625rem;">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <h2 class="card-title">{title}</h2>
        <p class="card-desc line-clamp-2">{description}</p>
      </div>
      {image && (
        <div class="hidden md:block flex-shrink-0 w-32 h-24 rounded-lg overflow-hidden" style="border: 1px solid var(--border);">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
          />
        </div>
      )}
    </div>
  </a>
</article>
