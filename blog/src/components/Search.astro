---
---

<section class="search-shell paper-surface mb-12 p-4 sm:p-5">
  <label for="search-input" class="mono-label block mb-3">Search Notes</label>
  <div class="relative">
    <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.9-3.9"></path>
    </svg>
    <input
      type="search"
      id="search-input"
      placeholder="Find by title, summary, or tag"
      class="search-input w-full pl-10 pr-4 py-3.5 outline-none"
      autocomplete="off"
    />
  </div>
  <div id="search-results" class="search-results mt-4 hidden"></div>
</section>

<style>
  .search-shell {
    position: relative;
  }

  .search-shell::before {
    content: '';
    position: absolute;
    right: 1rem;
    top: 0.9rem;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 42%, var(--border));
    border-radius: 9999px;
    opacity: 0.6;
    pointer-events: none;
  }

  .search-icon {
    position: absolute;
    left: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1rem;
    height: 1rem;
    color: var(--text-subtle);
  }

  .search-input {
    border-radius: 0.78rem;
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    background: color-mix(in srgb, var(--bg-surface) 72%, transparent);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .search-input:focus {
    border-color: color-mix(in srgb, var(--color-accent) 48%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 14%, transparent);
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
  }

  .search-input::placeholder {
    color: var(--text-subtle);
  }

  .search-results {
    display: grid;
    gap: 0.5rem;
  }

  .search-hit {
    display: block;
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--bg-elevated) 92%, transparent);
    padding: 0.85rem 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-hit:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 46%, var(--border));
    box-shadow: var(--shadow-soft);
  }

  .search-hit-title {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.28rem;
    line-height: 1.16;
    color: var(--text);
  }

  .search-hit-desc {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.48;
  }

  .search-hit-tags {
    margin-top: 0.56rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  @media (max-width: 640px) {
    .search-hit-title {
      font-size: 1.18rem;
    }
  }
</style>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    tags: string[];
  }

  let searchIndex: SearchItem[] = [];

  fetch('/search.json')
    .then((response) => response.json())
    .then((data) => {
      searchIndex = data;
    });

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results') as HTMLDivElement;

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

    if (!query) {
      searchResults.classList.add('hidden');
      searchResults.innerHTML = '';
      return;
    }

    const results = searchIndex.filter((item) => (
      item.title.toLowerCase().includes(query)
      || item.description.toLowerCase().includes(query)
      || item.tags.some((tag) => tag.toLowerCase().includes(query))
    ));

    if (results.length === 0) {
      searchResults.innerHTML = `<p style="color: var(--text-muted); font-size: 0.875rem; padding: 0.4rem 0.1rem;">No matching posts.</p>`;
      searchResults.classList.remove('hidden');
      return;
    }

    searchResults.innerHTML = results
      .map(
        (item) => `
        <a href="/${item.slug}" class="search-hit">
          <h3 class="search-hit-title">${item.title}</h3>
          <p class="search-hit-desc">${item.description}</p>
          ${
            item.tags.length > 0
              ? `<div class="search-hit-tags">
                ${item.tags
                  .map((tag) => `<span class="tag-pill" style="padding: 0.1rem 0.48rem; font-size: 0.61rem;">${tag}</span>`)
                  .join('')}
              </div>`
              : ''
          }
        </a>
      `,
      )
      .join('');

    searchResults.classList.remove('hidden');
  });
</script>
