---
---

<section class="mb-10">
  <label for="search-input" class="mono-label block mb-2">Search</label>
  <input
    type="search"
    id="search-input"
    placeholder="Search by title, description, or tag"
    class="search-input w-full px-3 py-3 outline-none"
    autocomplete="off"
  />
  <div id="search-results" class="search-results mt-4 hidden"></div>
</section>

<style>
  .search-input {
    border: 1px solid var(--border);
    border-radius: 0.55rem;
    background: var(--bg);
    color: var(--text);
    font-size: 0.94rem;
  }

  .search-input:focus {
    border-color: var(--text-subtle);
  }

  .search-input::placeholder {
    color: var(--text-subtle);
  }

  .search-results {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .search-hit {
    display: block;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }

  .search-hit-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--text);
  }

  .search-hit-desc {
    margin: 0.28rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .search-hit-tags {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    tags: string[];
  }

  let searchIndex: SearchItem[] = [];

  fetch('/search.json')
    .then((response) => response.json())
    .then((data) => {
      searchIndex = data;
    });

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results') as HTMLDivElement;

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

    if (!query) {
      searchResults.classList.add('hidden');
      searchResults.innerHTML = '';
      return;
    }

    const results = searchIndex.filter((item) => (
      item.title.toLowerCase().includes(query)
      || item.description.toLowerCase().includes(query)
      || item.tags.some((tag) => tag.toLowerCase().includes(query))
    ));

    if (results.length === 0) {
      searchResults.innerHTML = `<p style="color: var(--text-muted); font-size: 0.875rem; padding: 0.75rem 0;">No matching posts.</p>`;
      searchResults.classList.remove('hidden');
      return;
    }

    searchResults.innerHTML = results
      .map(
        (item) => `
        <a href="/${item.slug}" class="search-hit">
          <h3 class="search-hit-title">${item.title}</h3>
          <p class="search-hit-desc">${item.description}</p>
          ${
            item.tags.length > 0
              ? `<div class="search-hit-tags">
                ${item.tags
                  .map((tag) => `<span class="tag-pill">${tag}</span>`)
                  .join('')}
              </div>`
              : ''
          }
        </a>
      `,
      )
      .join('');

    searchResults.classList.remove('hidden');
  });
</script>
