---
interface TableOfContentsItem {
  id: string;
  label: string;
  depth?: number;
}

interface Props {
  items: TableOfContentsItem[];
  title?: string;
  class?: string;
  showMobile?: boolean;
  collapsible?: boolean;
  defaultCollapsed?: boolean;
}

const {
  items,
  title = 'On this page',
  class: className = '',
  showMobile = false,
  collapsible = true,
  defaultCollapsed = false,
} = Astro.props as Props;

const normalizedItems = (items ?? [])
  .filter((item) => item?.id && item?.label)
  .map((item) => ({
    ...item,
    depth: Math.max(1, item.depth ?? 1),
  }));

const visibilityClass = showMobile ? '' : 'hidden lg:block';
---

{
  normalizedItems.length > 0 && (
    <aside class={`${visibilityClass} ${className}`}>
      <nav
        data-toc-root
        data-toc-collapsible={collapsible ? 'true' : 'false'}
        data-toc-default-collapsed={defaultCollapsed ? 'true' : 'false'}
        class="toc-shell sticky top-24 rounded-xl border p-4"
        style="border-color: var(--border); background: color-mix(in srgb, var(--bg-surface) 65%, transparent);"
        aria-label={title}
      >
        <div class="flex items-center justify-between gap-3">
          <p class="mono-label">{title}</p>
          {collapsible && (
            <button
              type="button"
              data-toc-toggle
              aria-expanded={String(!defaultCollapsed)}
              class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs transition-colors"
              style="color: var(--text-muted);"
            >
              <span data-toc-toggle-label>{defaultCollapsed ? 'Expand' : 'Collapse'}</span>
              <svg
                data-toc-toggle-icon
                class={`w-3 h-3 transition-transform ${defaultCollapsed ? '' : 'rotate-180'}`}
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25 12 15.75 4.5 8.25" />
              </svg>
            </button>
          )}
        </div>
        <ol data-toc-list class={`mt-3 space-y-1.5 ${defaultCollapsed ? 'hidden' : ''}`}>
          {normalizedItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-toc-link
                class="toc-link block rounded-md py-1.5 text-sm transition-colors"
                style={`padding-left: ${0.625 + (item.depth - 1) * 0.75}rem;`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script is:inline>
  document.querySelectorAll('[data-toc-root]').forEach((tocRoot) => {
    if (tocRoot.dataset.tocBound === 'true') {
      return;
    }
    tocRoot.dataset.tocBound = 'true';

    const isCollapsible = tocRoot.dataset.tocCollapsible === 'true';
    const defaultCollapsed = tocRoot.dataset.tocDefaultCollapsed === 'true';
    const toggleButton = tocRoot.querySelector('[data-toc-toggle]');
    const toggleLabel = tocRoot.querySelector('[data-toc-toggle-label]');
    const toggleIcon = tocRoot.querySelector('[data-toc-toggle-icon]');
    const tocList = tocRoot.querySelector('[data-toc-list]');
    const storageKey = `toc-collapsed:${window.location.pathname}`;

    let isCollapsed = defaultCollapsed;

    if (isCollapsible && tocList && toggleButton) {
      try {
        const saved = window.localStorage.getItem(storageKey);
        if (saved !== null) {
          isCollapsed = saved === 'true';
        }
      } catch {
        // Ignore localStorage access errors.
      }

      const applyCollapsed = (nextCollapsed) => {
        isCollapsed = nextCollapsed;
        tocRoot.dataset.tocCollapsed = String(isCollapsed);
        tocList.classList.toggle('hidden', isCollapsed);
        toggleButton.setAttribute('aria-expanded', String(!isCollapsed));

        if (toggleLabel) {
          toggleLabel.textContent = isCollapsed ? 'Expand' : 'Collapse';
        }
        if (toggleIcon) {
          toggleIcon.classList.toggle('rotate-180', !isCollapsed);
        }
      };

      applyCollapsed(isCollapsed);

      toggleButton.addEventListener('click', () => {
        applyCollapsed(!isCollapsed);
        try {
          window.localStorage.setItem(storageKey, String(isCollapsed));
        } catch {
          // Ignore localStorage access errors.
        }
      });
    }

    const links = Array.from(tocRoot.querySelectorAll('a[data-toc-link]'));
    const entries = links
      .map((link) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) {
          return null;
        }

        const target = document.getElementById(href.slice(1));
        if (!target) {
          return null;
        }

        return { link, target };
      })
      .filter(Boolean);

    if (!entries.length) {
      return;
    }

    const setActive = (id) => {
      links.forEach((link) => {
        const isActive = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('toc-link-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let activeId = entries[0].target.id;

    const updateActive = () => {
      const marker = window.scrollY + window.innerHeight * 0.25;
      let nextId = entries[0].target.id;

      for (const entry of entries) {
        if (entry.target.offsetTop <= marker) {
          nextId = entry.target.id;
        } else {
          break;
        }
      }

      if (nextId !== activeId) {
        activeId = nextId;
        setActive(activeId);
      }
    };

    setActive(activeId);
    updateActive();

    window.addEventListener('scroll', updateActive, { passive: true });
    window.addEventListener('resize', updateActive);
  });
</script>
