---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40" style="background: var(--bg); border-bottom: 1px solid var(--border);">
  <nav class="mx-auto max-w-5xl px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-y-3">
    <a href="/" class="display-heading text-2xl sm:text-3xl leading-none" style="color: var(--text); text-decoration: none;">
      agent-zym
    </a>

    <div class="flex w-full sm:w-auto items-center justify-between sm:justify-end gap-4 sm:gap-6">
      <a href="/" class="nav-link">Home</a>
      <a href="/harness" class="nav-link">Harness</a>
      <a href="/tags" class="nav-link">Tags</a>
      <a href="/rss.xml" class="nav-link">RSS</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .nav-link {
      font-size: 0.84rem;
    }
  }
</style>
