---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md" style="background-color: color-mix(in srgb, var(--bg) 85%, transparent);">
  <nav class="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between">
    <a href="/" class="group flex items-center gap-2">
      <span class="display-heading text-xl tracking-tight" style="color: var(--text);">agent-zym</span>
      <span class="inline-block w-2 h-2 rounded-full bg-accent opacity-80 group-hover:scale-125 transition-transform"></span>
    </a>

    <div class="flex items-center gap-8">
      <a href="/" class="mono-label link-underline" style="font-size: 0.6875rem;">Home</a>
      <a href="/harness" class="mono-label link-underline" style="font-size: 0.6875rem;">Harness</a>
      <a href="/rss.xml" class="mono-label link-underline" style="font-size: 0.6875rem;">RSS</a>
      <ThemeToggle />
    </div>
  </nav>
  <div class="mx-auto max-w-5xl px-6">
    <div style="height: 1px; background: var(--border);"></div>
  </div>
</header>
