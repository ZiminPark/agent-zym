---
interface Props {
  markdownPath: string;
  title: string;
  canonicalPath?: string;
  pubDate?: string;
  tags?: string[];
  hint?: string;
  motivationText?: string;
  align?: 'start' | 'end';
  className?: string;
}

const {
  markdownPath,
  title,
  canonicalPath,
  pubDate,
  tags = [],
  hint = 'Use this page as source context. Quote accurately when needed.',
  motivationText = 'Send this page to Claude/ChatGPT quickly. Choose Open Markdown when you need a shareable, fetchable source URL for coding agents.',
  align = 'start',
  className = '',
} = Astro.props;

const alignmentClass = align === 'end' ? 'context-actions-end' : '';
const showMotivation = motivationText.trim().length > 0 && align !== 'end';
const compactClass = showMotivation ? '' : 'context-actions-compact';
---

<div
  class={`context-actions ${alignmentClass} ${compactClass} ${className}`}
  data-markdown-path={markdownPath}
  data-title={title}
  data-canonical-path={canonicalPath ?? ''}
  data-pub-date={pubDate ?? ''}
  data-tags={tags.join(', ')}
  data-hint={hint}
>
  {showMotivation && <p class="context-motivation">{motivationText}</p>}
  <div class="context-menu-wrap">
    <div class="context-btn-group">
      <button
        type="button"
        class="context-btn context-btn-primary context-btn-main"
        data-role="primary-action"
      >
        <span data-role="primary-label">Copy Page</span>
      </button>
      <button
        type="button"
        class="context-btn context-btn-primary context-btn-toggle"
        data-role="menu-trigger"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="Show copy options"
      >
        <svg class="context-chevron" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </div>
    <div class="context-menu" data-role="menu" role="menu" hidden>
      <button type="button" class="context-menu-item" data-role="copy-option" role="menuitem">
        <span class="context-menu-title">Copy Page</span>
        <span class="context-menu-desc">Copy this page as LLM-ready context for chat.</span>
      </button>
      <a
        href={markdownPath}
        class="context-menu-item"
        data-role="open-option"
        role="menuitem"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="context-menu-title">Open Markdown</span>
        <span class="context-menu-desc">Best for sharing a fetchable source URL with an agent.</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!(root instanceof HTMLElement) || !root.classList.contains('context-actions')) return;

    const primaryAction = root.querySelector('button[data-role="primary-action"]');
    const primaryLabel = root.querySelector('[data-role="primary-label"]');
    const menuTrigger = root.querySelector('button[data-role="menu-trigger"]');
    const menu = root.querySelector('[data-role="menu"]');
    const copyOption = root.querySelector('button[data-role="copy-option"]');
    const openOption = root.querySelector('a[data-role="open-option"]');

    if (!(primaryAction instanceof HTMLButtonElement)) return;
    if (!(menuTrigger instanceof HTMLButtonElement)) return;
    if (!(menu instanceof HTMLElement)) return;
    if (!(copyOption instanceof HTMLButtonElement)) return;

    const markdownPath = root.dataset.markdownPath || '';
    const title = root.dataset.title || document.title;
    const canonicalPath = root.dataset.canonicalPath || window.location.pathname;
    const pubDate = root.dataset.pubDate || '';
    const tags = root.dataset.tags || '';
    const hint = root.dataset.hint || 'Use this page as source context. Quote accurately when needed.';
    const defaultLabel = 'Copy Page';

    let isBusy = false;
    let isMenuOpen = false;
    let resetTimer = null;

    const setPrimaryLabel = (text) => {
      if (primaryLabel instanceof HTMLElement) {
        primaryLabel.textContent = text;
        return;
      }
      primaryAction.textContent = text;
    };

    const closeMenu = () => {
      isMenuOpen = false;
      menu.hidden = true;
      menuTrigger.setAttribute('aria-expanded', 'false');
      root.classList.remove('is-open');
    };

    const openMenu = () => {
      isMenuOpen = true;
      menu.hidden = false;
      menuTrigger.setAttribute('aria-expanded', 'true');
      root.classList.add('is-open');
    };

    const toggleMenu = () => {
      if (isMenuOpen) {
        closeMenu();
        return;
      }
      openMenu();
    };

    const resetLabelLater = () => {
      if (resetTimer) window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        setPrimaryLabel(defaultLabel);
      }, 2000);
    };

    const MAX_HYPERLINKS = 60;

    const trimTrailingPunctuation = (value) => value.replace(/[),.;!?]+$/g, '');

    const normalizeHttpUrl = (rawUrl, baseUrl) => {
      try {
        const resolved = new URL(trimTrailingPunctuation(rawUrl), baseUrl);
        if (resolved.protocol !== 'http:' && resolved.protocol !== 'https:') {
          return '';
        }
        return resolved.toString();
      } catch {
        return '';
      }
    };

    const extractOneDepthHyperlinks = (sourceText, baseUrl) => {
      const hyperlinks = [];
      const seen = new Set();

      const pushLink = (label, rawUrl) => {
        if (hyperlinks.length >= MAX_HYPERLINKS) return;
        const normalizedUrl = normalizeHttpUrl(rawUrl, baseUrl);
        if (!normalizedUrl || seen.has(normalizedUrl)) return;
        seen.add(normalizedUrl);
        hyperlinks.push({
          label: (label || 'Link').replace(/\s+/g, ' ').trim() || 'Link',
          url: normalizedUrl,
        });
      };

      const markdownLinkRegex = /\[([^\]]+)\]\(([^)]+)\)/g;
      for (const match of sourceText.matchAll(markdownLinkRegex)) {
        const label = match[1] || '';
        const destination = (match[2] || '').trim().replace(/^<|>$/g, '').match(/^\S+/)?.[0] || '';
        if (!destination) continue;
        pushLink(label, destination);
      }

      const markdownRefRegex = /^\[([^\]]+)\]:\s*(\S+)/gm;
      for (const match of sourceText.matchAll(markdownRefRegex)) {
        const label = match[1] || '';
        const destination = match[2] || '';
        if (!destination) continue;
        pushLink(label, destination);
      }

      const autoLinkRegex = /<((?:https?:\/\/)[^>\s]+)>/g;
      for (const match of sourceText.matchAll(autoLinkRegex)) {
        const destination = match[1] || '';
        if (!destination) continue;
        pushLink(destination, destination);
      }

      const bareUrlRegex = /\bhttps?:\/\/[^\s<>()]+/g;
      for (const match of sourceText.matchAll(bareUrlRegex)) {
        const destination = match[0] || '';
        if (!destination) continue;
        pushLink(destination, destination);
      }

      return hyperlinks;
    };

    const buildPayload = (markdownText) => {
      const trimmed = markdownText.trim();
      if (/^#\s*Context:/i.test(trimmed)) {
        return trimmed;
      }

      const canonicalURL = new URL(canonicalPath, window.location.origin).toString();
      const hyperlinks = extractOneDepthHyperlinks(trimmed, canonicalURL);
      const lines = [`# Context: ${title}`, `- URL: ${canonicalURL}`];

      if (pubDate) {
        lines.push(`- Published: ${pubDate}`);
      }

      lines.push(`- Tags: ${tags || 'none'}`);
      lines.push('');
      lines.push('## User intent hint');
      lines.push(hint);
      lines.push('');
      if (hyperlinks.length > 0) {
        lines.push('## Hyperlinks (1-depth)');
        for (const link of hyperlinks) {
          lines.push(`- ${link.label}: ${link.url}`);
        }
        lines.push('');
      }
      lines.push('## Article content');
      lines.push(trimmed);
      lines.push('');
      return lines.join('\n');
    };

    const runCopyAction = async () => {
      if (isBusy || !markdownPath) return;

      isBusy = true;
      setPrimaryLabel('Copying...');

      try {
        const response = await fetch(markdownPath);
        if (!response.ok) {
          throw new Error(`Failed to fetch markdown: ${response.status}`);
        }

        const markdownText = await response.text();
        const payload = buildPayload(markdownText);
        await navigator.clipboard.writeText(payload);
        setPrimaryLabel('Copied!');
        resetLabelLater();
      } catch (_error) {
        setPrimaryLabel('Failed');
        resetLabelLater();
      } finally {
        isBusy = false;
      }
    };

    menuTrigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      toggleMenu();
    });

    primaryAction.addEventListener('click', async (event) => {
      event.preventDefault();
      event.stopPropagation();
      closeMenu();
      await runCopyAction();
    });

    document.addEventListener('click', (event) => {
      if (!isMenuOpen) return;
      if (!(event.target instanceof Node)) return;
      if (!root.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
      }
    });

    copyOption.addEventListener('click', async () => {
      closeMenu();
      await runCopyAction();
    });

    if (openOption instanceof HTMLAnchorElement) {
      openOption.addEventListener('click', () => {
        closeMenu();
        setPrimaryLabel('Opened Markdown');
        resetLabelLater();
      });
    }
  })();
</script>

<style>
  .context-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .context-actions-compact {
    gap: 0;
  }

  .context-motivation {
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--text-subtle);
    max-width: 56ch;
  }

  .context-menu-wrap {
    position: relative;
  }

  .context-actions-end {
    align-items: flex-end;
    text-align: right;
  }

  .context-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border-radius: 9999px;
    padding: 0.45rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-decoration: none;
  }

  .context-btn-group {
    display: inline-flex;
    align-items: stretch;
  }

  .context-btn-main {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: 0;
  }

  .context-btn-toggle {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding-inline: 0.56rem;
    min-width: 2rem;
  }

  .context-btn-group:hover .context-btn-primary {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .context-btn-primary {
    color: var(--text);
    background: var(--bg-surface);
  }

  .context-btn-primary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .context-chevron {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.2s ease;
  }

  .context-actions.is-open .context-chevron {
    transform: rotate(180deg);
  }

  .context-menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    z-index: 40;
    width: min(24rem, 88vw);
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--bg);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }

  .context-actions-end .context-menu {
    left: auto;
    right: 0;
  }

  .context-menu-item {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.18rem;
    border: 0;
    background: transparent;
    text-align: left;
    padding: 0.72rem 0.88rem;
    text-decoration: none;
    cursor: pointer;
    color: inherit;
  }

  .context-menu-item + .context-menu-item {
    border-top: 1px solid var(--border);
  }

  .context-menu-item:hover {
    background: var(--bg-surface);
  }

  .context-menu-title {
    font-size: 0.79rem;
    font-weight: 600;
    color: var(--text);
  }

  .context-menu-desc {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .context-motivation {
      max-width: 100%;
    }

    .context-menu {
      width: min(22rem, 92vw);
    }
  }
</style>
