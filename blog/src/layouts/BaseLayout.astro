---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  tags?: string[];
}

const { title, description, image, type, pubDate, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} pubDate={pubDate} tags={tags} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 mx-auto w-full max-w-5xl px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
